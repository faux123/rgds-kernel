	rockchip,pins = <2 RK_PB2 1 &pcfg_pull_up>;
};

&sdmmc1_pwren {
	rockchip,pins = <2 RK_PB1 1 &pcfg_pull_none>;
};

&sdmmc2 {
	clocks = <&cru HCLK_SDMMC2>, <&cru CLK_SDMMC2>, <&cru SCLK_SDMMC2_DRV>, <&cru SCLK_SDMMC2_SAMPLE>;
	max-frequency = <100000000>;
	resets = <&cru SRST_SDMMC2>;
	status = "okay";
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2m0_bus4 &sdmmc2m0_cmd &sdmmc2m0_clk>;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	rockchip,default-sample-phase = <90>;
};

&sdmmc2m0_bus4 {
	rockchip,pins = <3 RK_PC6 3 &pcfg_pull_up_drv_level_2>,
			<3 RK_PC7 3 &pcfg_pull_up_drv_level_2>,
			<3 RK_PD0 3 &pcfg_pull_up_drv_level_2>,
			<3 RK_PD1 3 &pcfg_pull_up_drv_level_2>;
};

