};

&usb_host1_ehci {
	clocks = <&cru HCLK_USB2HOST1>, <&cru HCLK_USB2HOST1_ARB>, <&cru PCLK_USB>, <&usb2phy1>;
	phys = <&u2phy1_host>;
	status = "okay";
};

&usb_host1_ohci {
	clocks = <&cru HCLK_USB2HOST1>, <&cru HCLK_USB2HOST1_ARB>, <&cru PCLK_USB>, <&usb2phy1>;
	phys = <&u2phy1_host>;
	status = "okay";
};

&usbdrd30 {
	clocks = <&cru CLK_USB3OTG0_REF>, <&cru CLK_USB3OTG0_SUSPEND>, <&cru ACLK_USB3OTG0>, <&cru PCLK_PIPE>;
	status = "okay";
};

&usbdrd_dwc3 {
	power-domains = <&power 15>;
	resets = <&cru SRST_USB3OTG0>;
	status = "okay";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	extcon = <&usb2phy0>;
	maximum-speed = "high-speed";
	snps,dis_u2_susphy_quirk;
	snps,usb2-lpm-disable;
};

&usbhost30 {
	clocks = <&cru CLK_USB3OTG1_REF>, <&cru CLK_USB3OTG1_SUSPEND>, <&cru ACLK_USB3OTG1>, <&cru PCLK_PIPE>;
	status = "okay";
};

&usbhost_dwc3 {
	phys = <&u2phy0_host>, <&combphy1_usq 4>;
	power-domains = <&power 15>;
	resets = <&cru SRST_USB3OTG1>;
};

&vad {
	clocks = <&cru HCLK_VAD>;
};

&vdpu {
	clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
	resets = <&cru SRST_A_VPU>, <&cru SRST_H_VPU>;
	iommus = <&vdpu_mmu>;
	power-domains = <&power 11>;
	rockchip,srv = <&mpp_srv>;
	status = "okay";
};

&vdpu_mmu {
	clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
	power-domains = <&power 11>;
	status = "okay";
};

&vendor_storage {
	memory-region = <&vendor_storage_rm>;
};

&vepu {
	clocks = <&cru ACLK_JENC>, <&cru HCLK_JENC>;
	resets = <&cru SRST_A_JENC>, <&cru SRST_H_JENC>;
	iommus = <&vepu_mmu>;
	rockchip,srv = <&mpp_srv>;
	power-domains = <&power 10>;
	status = "okay";
};

&vepu_mmu {
	clocks = <&cru ACLK_JENC>, <&cru HCLK_JENC>;
	power-domains = <&power 10>;
	status = "okay";
};

&video_phy0 {
	clocks = <&pmucru CLK_MIPIDSIPHY0_REF>, <&cru PCLK_MIPIDSIPHY0>, <&cru PCLK_DSITX_0>;
	resets = <&cru SRST_P_MIPIDSIPHY0>;
	power-domains = <&power 9>;
	status = "okay";
};

&video_phy1 {
	clocks = <&pmucru CLK_MIPIDSIPHY1_REF>, <&cru PCLK_MIPIDSIPHY1>, <&cru PCLK_DSITX_1>;
	resets = <&cru SRST_P_MIPIDSIPHY1>;
	power-domains = <&power 9>;
	status = "okay";
};

&vop {
	clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>, <&cru DCLK_VOP0>, <&cru DCLK_VOP1>, <&cru DCLK_VOP2>;
	operating-points-v2 = <&vop_opp_table>;
	iommus = <&vop_mmu>;
	power-domains = <&power 9>;
	rockchip,grf = <&grf>;
	status = "okay";
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	vop-supply = <&vdd_logic>;
};

&vop_mmu {
	clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>;
	status = "okay";
};

&vop_opp_table {
	nvmem-cells = <&log_leakage &core_pvtm>;
};

&vopm0_pins {
	rockchip,pins = <0 RK_PC3 2 &pcfg_pull_none>;
};

&vopm1_pins {
	rockchip,pins = <3 RK_PC4 2 &pcfg_pull_none>;
};

