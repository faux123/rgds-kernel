// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/dts-v1/;

#include "rk3568.dtsi"
#include "rk3568-android.dtsi"

/ {
	compatible = "rockchip,rk3566-rk817-tablet", "rockchip,rk3566";
	model = "Anbernic RG DS (rk3568)";
};

&{/aliases} {
	csi2dphy0 = "/csi2-dphy0";
	csi2dphy1 = "/csi2-dphy1";
	csi2dphy2 = "/csi2-dphy2";
	dsi0 = "/dsi@fe060000";
	dsi1 = "/dsi@fe070000";
	ethernet1 = "/ethernet@fe010000";
	gpio0 = "/pinctrl/gpio@fdd60000";
	gpio1 = "/pinctrl/gpio@fe740000";
	gpio2 = "/pinctrl/gpio@fe750000";
	gpio3 = "/pinctrl/gpio@fe760000";
	gpio4 = "/pinctrl/gpio@fe770000";
	i2c0 = "/i2c@fdd40000";
	i2c1 = "/i2c@fe5a0000";
	i2c2 = "/i2c@fe5b0000";
	i2c3 = "/i2c@fe5c0000";
	i2c4 = "/i2c@fe5d0000";
	i2c5 = "/i2c@fe5e0000";
	mmc0 = "/dwmmc@fe2b0000";
	mmc1 = "/dwmmc@fe2c0000";
	mmc2 = "/sdhci@fe310000";
	mmc3 = "/dwmmc@fe000000";
	serial0 = "/serial@fdd50000";
	serial1 = "/serial@fe650000";
	serial2 = "/serial@fe660000";
	serial3 = "/serial@fe670000";
	serial4 = "/serial@fe680000";
	serial5 = "/serial@fe690000";
	serial6 = "/serial@fe6a0000";
	serial7 = "/serial@fe6b0000";
	serial8 = "/serial@fe6c0000";
	serial9 = "/serial@fe6d0000";
	spi0 = "/spi@fe610000";
	spi1 = "/spi@fe620000";
	spi2 = "/spi@fe630000";
	spi3 = "/spi@fe640000";
	ethernet0 = "/ethernet@fe2a0000";
	lvds0 = "/syscon@fdc60000/lvds";
	lvds1 = "/syscon@fdc60000/lvds1";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu0_opp_table {
	nvmem-cells = <&cpu_leakage &core_pvtm &mbist_vmin &cpu_opp_info &specification_serial_number &remark_spec_serial_number>;
};

&{/cpuinfo} {
	nvmem-cells = <&otp_id &otp_cpu_version &cpu_code &specification_serial_number &remark_spec_serial_number>;
};

&display_subsystem {
	memory-region = <&drm_logo &drm_cubic_lut>;
	ports = <&vop_out>;
	devfreq = <&dmc>;
};

&route_dsi0 {
	status = "okay";
	connect = <&vp0_out_dsi0>;
};

&route_dsi1 {
	status = "okay";
	connect = <&vp1_out_dsi1>;
};

&route_edp {
	connect = <&vp0_out_edp>;
};

&route_hdmi {
	connect = <&vp0_out_hdmi>;
};

&route_lvds {
	connect = <&vp1_out_lvds>;
};

&route_rgb {
	connect = <&vp2_out_rgb>;
};

&scmi {
	shmem = <&scmi_shmem>;
};

&gpu_opp_table {
	nvmem-cells = <&gpu_leakage &core_pvtm &mbist_vmin &gpu_opp_info &specification_serial_number &remark_spec_serial_number>;
};

&hdmi_sound {
	simple-audio-card,name = "rockchip,hdmi";
	simple-audio-card,mclk-fs = <0x80>;
};

&{/hdmi-sound/simple-audio-card,codec} {
	sound-dai = <&hdmi>;
};

&{/hdmi-sound/simple-audio-card,cpu} {
	sound-dai = <&i2s0_8ch>;
};

&mipi_csi2 {
	rockchip,hw = <&mipi_csi2_hw>;
};

&mpp_srv {
	status = "okay";
};

&arm_pmu {
	interrupt-affinity = <&cpu0 &cpu1 &cpu2 &cpu3>;
};

&xin32k {
	pinctrl-0 = <&clk32k_out0>;
};

&sata1 {
	clocks = <&cru 0x9b &cru 0x9c &cru 0x9d>;
	phys = <&combphy1_usq 0x1>;
	power-domains = <&power 0xf>;
};

&sata2 {
	clocks = <&cru 0xa0 &cru 0xa1 &cru 0xa2>;
	phys = <&combphy2_psq 0x1>;
	power-domains = <&power 0xf>;
};

&usbdrd30 {
	clocks = <&cru 0xa6 &cru 0xa7 &cru 0xa5 &cru 0x7f>;
	status = "okay";
};

&usbdrd_dwc3 {
	power-domains = <&power 0xf>;
	resets = <&cru 0x94>;
	status = "okay";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	extcon = <&usb2phy0>;
	maximum-speed = "high-speed";
	snps,dis_u2_susphy_quirk;
	snps,usb2-lpm-disable;
};

&usbhost30 {
	clocks = <&cru 0xa9 &cru 0xaa &cru 0xa8 &cru 0x7f>;
	status = "okay";
};

&usbhost_dwc3 {
	phys = <&u2phy0_host &combphy1_usq 0x4>;
	power-domains = <&power 0xf>;
	resets = <&cru 0x95>;
};

&usb_host0_ehci {
	clocks = <&cru 0xbd &cru 0xbe &cru 0xbc &usb2phy1>;
	phys = <&u2phy1_otg>;
	status = "okay";
};

&usb_host0_ohci {
	clocks = <&cru 0xbd &cru 0xbe &cru 0xbc &usb2phy1>;
	phys = <&u2phy1_otg>;
	status = "okay";
};

&usb_host1_ehci {
	clocks = <&cru 0xbf &cru 0xc0 &cru 0xbc &usb2phy1>;
	phys = <&u2phy1_host>;
	status = "okay";
};

&usb_host1_ohci {
	clocks = <&cru 0xbf &cru 0xc0 &cru 0xbc &usb2phy1>;
	phys = <&u2phy1_host>;
	status = "okay";
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio1-supply = <&vccio_acodec>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcc_3v3>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_1v8>;
	vccio7-supply = <&vcc_3v3>;
};

&lvds0 {
	phys = <&video_phy0>;
};

&lvds0_in_vp1 {
	remote-endpoint = <&vp1_out_lvds>;
};

&lvds0_in_vp2 {
	remote-endpoint = <&vp2_out_lvds>;
};

&rgb {
	pinctrl-0 = <&lcdc_ctl>;
};

&rgb_in_vp2 {
	remote-endpoint = <&vp2_out_rgb>;
};

&lvds1 {
	phys = <&video_phy1>;
};

&lvds1_in_vp1 {
	remote-endpoint = <&vp1_out_lvds1>;
};

&lvds1_in_vp2 {
	remote-endpoint = <&vp2_out_lvds1>;
};

&edp_phy_grf {
	clocks = <&cru 0x192>;
};

&edp_phy {
	clocks = <&pmucru 0x29>;
};

&pmucru {
	rockchip,grf = <&grf>;
	rockchip,pmugrf = <&pmugrf>;
	assigned-clocks = <&pmucru 0x32>;
	assigned-clock-parents = <&pmucru 0x5>;
};

&cru {
	rockchip,grf = <&grf>;
	assigned-clocks = <&pmucru 0x5 &cru 0x106 &cru 0x10b &pmucru 0x1 &pmucru 0x2b &cru 0x3 &cru 0x19b &cru 0x9 &cru 0x19c &cru 0x19d &cru 0x1a1 &cru 0x19e &cru 0x19f &cru 0x1a0 &cru 0x4 &cru 0x10d &cru 0x10e &cru 0x173 &cru 0x174 &cru 0x175 &cru 0x176 &cru 0xc9 &cru 0xca &cru 0x6 &cru 0x7e &cru 0x7f &cru 0x3d &cru 0x41 &cru 0x45 &cru 0x49 &cru 0x4d &cru 0x4d &cru 0x55 &cru 0x51 &cru 0x5d &cru 0xdd>;
	assigned-clock-parents = <&pmucru 0x8 &cru 0x4 &cru 0x4>;
};

&i2c0 {
	clocks = <&pmucru 0x7 &pmucru 0x2d>;
	pinctrl-0 = <&i2c0_xfer>;
	status = "okay";
};

&i2c0 {
	vdd_cpu: sti8070a@40 {
		compatible = "silergy,syr827";
		reg = <0x40>;
		vin-supply = <&vccsys>;
		regulator-compatible = "fan53555-reg";
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <0xadf34>;
		regulator-max-microvolt = <0x1535b0>;
		regulator-init-microvolt = <0xf4240>;
		regulator-ramp-delay = <0x8fc>;
		fcs,suspend-voltage-selector = <0x1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c0 {
	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <0x3 0x8>;
		pinctrl-names = "default", "pmic-sleep", "pmic-power-off", "pmic-reset";
		pinctrl-0 = <&pmic_int>;
		pinctrl-1 = <&soc_slppin_slp>;
		pinctrl-2 = <&soc_slppin_gpio>;
		pinctrl-3 = <&soc_slppin_gpio>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <0x1>;
		clock-output-names = "rk808-clkout1", "rk808-clkout2";
		pmic-reset-func = <0x0>;
		not-save-power-en = <0x1>;
		vcc1-supply = <&vccsys>;
		vcc2-supply = <&vccsys>;
		vcc3-supply = <&vccsys>;
		vcc4-supply = <&vccsys>;
		vcc5-supply = <&vccsys>;
		vcc6-supply = <&vccsys>;
		vcc7-supply = <&vccsys>;
		vcc8-supply = <&vccsys>;
		vcc9-supply = <&dcdc_boost>;
		pwrkey {
			status = "okay";
		};
		pinctrl_rk8xx: pinctrl_rk8xx {
			gpio-controller;
			#gpio-cells = <0x2>;
			rk817_slppin_null: rk817_slppin_null {
				pins = "gpio_slp";
				function = "pin_fun0";
			};
			rk817_slppin_slp: rk817_slppin_slp {
				pins = "gpio_slp";
				function = "pin_fun1";
			};
			rk817_slppin_pwrdn: rk817_slppin_pwrdn {
				pins = "gpio_slp";
				function = "pin_fun2";
			};
			rk817_slppin_rst: rk817_slppin_rst {
				pins = "gpio_slp";
				function = "pin_fun3";
			};
		};
		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xe7ef0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vdd_logic";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <0xdbba0>;
				};
			};
			vdd_gpu: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0xc96a8>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xe7ef0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vdd_gpu";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-name = "vcc_ddr";
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
			vcc_3v3: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-initial-mode = <0x2>;
				regulator-name = "vcc_3v3";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <0x325aa0>;
				};
			};
			vcca1v8_pmu: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcca1v8_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <0x1b7740>;
				};
			};
			vdda_0v9: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda_0v9";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vdda0v9_pmu: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda0v9_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <0xdbba0>;
				};
			};
			vccio_acodec: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vccio_acodec";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vccio_sd";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc3v3_pmu: LDO_REG6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vcc3v3_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <0x2dc6c0>;
				};
			};
			vcc_1v8: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcc_1v8";
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
			vcc1v8_dvp: LDO_REG8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vcc1v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc2v8_dvp: LDO_REG9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x2ab980>;
				regulator-max-microvolt = <0x2ab980>;
				regulator-name = "vcc2v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			dcdc_boost: BOOST {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <0x4c4b40>;
				regulator-max-microvolt = <0x4c4b40>;
				regulator-name = "boost";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
		simple_battery: simple-battery {
			compatible = "simple-battery";
			charge-full-design-microamp-hours = <0x2625a0>;
			precharge-current-microamp = <0x2bf20>;
			precharge-upper-limit-microvolt = <0x36ee80>;
			charge-term-current-microamp = <0x493e0>;
			constant-charge-current-max-microamp = <0x989680>;
			constant-charge-voltage-max-microvolt = <0x426030>;
			factory-internal-resistance-micro-ohms = <0x50>;
			voltage-max-design-microvolt = <0x426030>;
			voltage-min-design-microvolt = <0x2dc6c0>;
		};
		battery {
			compatible = "rk817,battery";
			ocv_table = <0xd48 0xe4f 0xe5d 0xe7b 0xe93 0xea5 0xeb1 0xebc 0xeca 0xef2 0xf15 0xf44 0xf6b 0xf8a 0xfc7 0xff3 0x1028 0x105f 0x109b 0x10f2>;
			design_capacity = <0x1097>;
			design_qmax = <0x1097>;
			bat_res = <0x45>;
			sleep_enter_current = <0x96>;
			sleep_exit_current = <0xb4>;
			sleep_filter_current = <0x64>;
			power_off_thresd = <0xdac>;
			zero_algorithm_vol = <0xf0a>;
			max_soc_offset = <0x3c>;
			monitor_sec = <0x5>;
			sample_res = <0xa>;
			virtual_power = <0x0>;
			status = "okay";
		};
		charger: charger {
			compatible = "rk817,charger";
			min_input_voltage = <0x1194>;
			max_input_current = <0x5dc>;
			max_chrg_current = <0x7d0>;
			max_chrg_voltage = <0x10fe>;
			chrg_term_mode = <0x2>;
			chrg_finish_cur = <0xc8>;
			virtual_power = <0x0>;
			dc_det_adc = <0x0>;
			extcon = <&usb2phy0>;
			status = "okay";
		};
		rk817_codec: codec {
			#sound-dai-cells = <0x0>;
			compatible = "rockchip,rk817-codec";
			clocks = <&cru 0x1a3>;
			clock-names = "mclk";
			assigned-clocks = <&cru 0x1a3 &cru 0x1a6>;
			assigned-clock-rates = <0xbb8000>;
			assigned-clock-parents = <&cru 0x48 &cru 0x48>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2s1m0_mclk>;
			hp-volume = <0x17>;
			spk-volume = <0xa>;
			mic-in-differential;
			use-ext-amplifier;
			spk-ctl-gpios = <&gpio4 0x13 0x0>;
			status = "okay";
		};
	};
};

&i2c0 {
	cw2015@62 {
		compatible = "cellwise,cw2015";
		reg = <0x62>;
		cellwise,battery-profile = <0x1767816f 0x69656354 0x75505756 0x4e4f4435 0x2c241e1b 0x2432414d 0x1c570b85 0x3454596d 0x85818184 0x3c1b6c6c 0xb411c4d 0x8095a014 0x387e98a3 0x808997cb 0x2f0064a5 0xb5c146ae>;
		cellwise,monitor-interval-ms = <0x1388>;
		monitored-battery = <&simple_battery>;
		battery_id = <0x0>;
		status = "okay";
	};
};

&uart0 {
	clocks = <&pmucru 0xb &pmucru 0x2c>;
	dmas = <&dmac0 0x0 &dmac0 0x1>;
	pinctrl-0 = <&uart0_xfer>;
};

&pwm0 {
	clocks = <&pmucru 0xd &pmucru 0x30>;
	pinctrl-0 = <&pwm0m0_pins>;
};

&pwm1 {
	clocks = <&pmucru 0xd &pmucru 0x30>;
	pinctrl-0 = <&pwm1m0_pins>;
};

&pwm2 {
	clocks = <&pmucru 0xd &pmucru 0x30>;
	pinctrl-0 = <&pwm2m0_pins>;
};

&pwm3 {
	clocks = <&pmucru 0xd &pmucru 0x30>;
	pinctrl-0 = <&pwm3_pins>;
};

&{/power-management@fdd90000/power-controller/power-domain@6} {
	clocks = <&cru 0x27 &cru 0x25 &cru 0x26>;
	pm_qos = <&qos_npu>;
};

&{/power-management@fdd90000/power-controller/power-domain@7} {
	clocks = <&cru 0x19 &cru 0x1a>;
	pm_qos = <&qos_gpu>;
};

&{/power-management@fdd90000/power-controller/power-domain@8} {
	clocks = <&cru 0xcc &cru 0xcd>;
	pm_qos = <&qos_isp &qos_vicap0 &qos_vicap1>;
};

&{/power-management@fdd90000/power-controller/power-domain@9} {
	clocks = <&cru 0xda &cru 0xdb &cru 0xdc>;
	pm_qos = <&qos_hdcp &qos_vop_m0 &qos_vop_m1>;
};

&{/power-management@fdd90000/power-controller/power-domain@10} {
	clocks = <&cru 0xf1 &cru 0xf2>;
	pm_qos = <&qos_ebc &qos_iep &qos_jpeg_dec &qos_jpeg_enc &qos_rga_rd &qos_rga_wr>;
};

&{/power-management@fdd90000/power-controller/power-domain@11} {
	clocks = <&cru 0xed>;
	pm_qos = <&qos_vpu>;
};

&{/power-management@fdd90000/power-controller/power-domain@13} {
	clocks = <&cru 0x107>;
	pm_qos = <&qos_rkvdec>;
};

&{/power-management@fdd90000/power-controller/power-domain@14} {
	clocks = <&cru 0x102>;
	pm_qos = <&qos_rkvenc_rd_m0 &qos_rkvenc_rd_m1 &qos_rkvenc_wr_m0>;
};

&{/power-management@fdd90000/power-controller/power-domain@15} {
	clocks = <&cru 0x7f>;
	pm_qos = <&qos_pcie2x1 &qos_pcie3x1 &qos_pcie3x2 &qos_sata0 &qos_sata1 &qos_sata2 &qos_usb3_0 &qos_usb3_1>;
