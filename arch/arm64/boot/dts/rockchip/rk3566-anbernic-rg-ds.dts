&dsi0 {
	clocks = <&cru PCLK_DSITX_0>, <&cru HCLK_VO>;
	phys = <&video_phy0>;
	power-domains = <&power 9>;
	resets = <&cru SRST_P_DSITX_0>;
	rockchip,grf = <&grf>;
	status = "okay";

	dsi0_panel: panel@0 {
		compatible = "aoly,sl008pa21y1285-b00", "simple-panel-dsi";
		status = "okay";
		reg = <0x0>;
		num = <0>;
		backlight = <&backlight>;
		enable-gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
		enable1-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_enable_gpio &lcd_rst_gpio>;
		stbyb-delay-ms = <10>;
		prepare-delay-ms = <10>;
		reset-delay-ms = <10>;
		init-delay-ms = <10>;
		enable-delay-ms = <10>;
		disable-delay-ms = <10>;
		unprepare-delay-ms = <10>;
		width-mm = <229>;
		height-mm = <143>;
		dsi,flags = <2051>;
		dsi,format = <0>;
		dsi,lanes = <4>;
		panel-init-sequence = [];
		panel-exit-sequence = <88080680 91750672>;
		panel-read-id-sequence = [0500020000];
		display-timings {
			native-mode = <&timing0>;
			timing0: timing0 {
				clock-frequency = <42100000>;
				hactive = <640>;
				vactive = <480>;
				hsync-len = <220>;
				hback-porch = <260>;
				hfront-porch = <260>;
				vsync-len = <2>;
				vback-porch = <16>;
				vfront-porch = <10>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0x0>;
				panel_in_dsi0: endpoint {
					remote-endpoint = <&dsi0_out_panel>;
				};
			};
		};
	};

	ports {
		port@1 {
			reg = <0x1>;
			dsi0_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi0>;
			};
		};
	};
};

