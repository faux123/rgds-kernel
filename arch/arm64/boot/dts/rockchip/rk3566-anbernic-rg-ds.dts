	rockchip,pins = <3 RK_PA7 3 &pcfg_pull_none>,
			<3 RK_PA6 3 &pcfg_pull_none_drv_level_2>;
};

&gmac1m0_rx_bus2 {
	rockchip,pins = <3 RK_PB1 3 &pcfg_pull_none>,
			<3 RK_PB2 3 &pcfg_pull_none>,
			<3 RK_PB3 3 &pcfg_pull_none>;
};

&gmac1m0_rx_er {
	rockchip,pins = <3 RK_PB4 3 &pcfg_pull_none>;
};

&gmac1m0_tx_bus2 {
	rockchip,pins = <3 RK_PB5 3 &pcfg_pull_none_drv_level_2>,
			<3 RK_PB6 3 &pcfg_pull_none_drv_level_2>,
			<3 RK_PB7 3 &pcfg_pull_none>;
};

&gmac1m0_tx_bus2_level3 {
	rockchip,pins = <3 RK_PB5 3 &pcfg_pull_none_drv_level_3>,
			<3 RK_PB6 3 &pcfg_pull_none_drv_level_3>,
			<3 RK_PB7 3 &pcfg_pull_none>;
};

&gmac1m1_clkinout {
	rockchip,pins = <4 RK_PC1 3 &pcfg_pull_none>;
};

&gmac1m1_miim {
	rockchip,pins = <4 RK_PB6 3 &pcfg_pull_none>,
			<4 RK_PB7 3 &pcfg_pull_none>;
};

&gmac1m1_rgmii_bus {
	rockchip,pins = <4 RK_PA1 3 &pcfg_pull_none>,
			<4 RK_PA2 3 &pcfg_pull_none>,
			<3 RK_PD6 3 &pcfg_pull_none_drv_level_2>,
			<3 RK_PD7 3 &pcfg_pull_none_drv_level_2>;
};

&gmac1m1_rgmii_bus_level3 {
	rockchip,pins = <4 RK_PA1 3 &pcfg_pull_none>,
			<4 RK_PA2 3 &pcfg_pull_none>,
			<3 RK_PD6 3 &pcfg_pull_none_drv_level_3>,
			<3 RK_PD7 3 &pcfg_pull_none_drv_level_3>;
};

&gmac1m1_rgmii_clk {
	rockchip,pins = <4 RK_PA3 3 &pcfg_pull_none>,
			<4 RK_PA0 3 &pcfg_pull_none_drv_level_1>;
};

&gmac1m1_rgmii_clk_level2 {
	rockchip,pins = <4 RK_PA3 3 &pcfg_pull_none>,
			<4 RK_PA0 3 &pcfg_pull_none_drv_level_2>;
};

&gmac1m1_rx_bus2 {
	rockchip,pins = <4 RK_PA7 3 &pcfg_pull_none>,
			<4 RK_PB0 3 &pcfg_pull_none>,
			<4 RK_PB1 3 &pcfg_pull_none>;
};

&gmac1m1_rx_er {
	rockchip,pins = <4 RK_PB2 3 &pcfg_pull_none>;
};

&gmac1m1_tx_bus2 {
	rockchip,pins = <4 RK_PA4 3 &pcfg_pull_none_drv_level_2>,
			<4 RK_PA5 3 &pcfg_pull_none_drv_level_2>,
			<4 RK_PA6 3 &pcfg_pull_none>;
};

&gmac1m1_tx_bus2_level3 {
	rockchip,pins = <4 RK_PA4 3 &pcfg_pull_none_drv_level_3>,
			<4 RK_PA5 3 &pcfg_pull_none_drv_level_3>,
			<4 RK_PA6 3 &pcfg_pull_none>;
};

&gmac_uio0 {
	rockchip,ethernet = <&gmac0>;
};

&gmac_uio1 {
	rockchip,ethernet = <&gmac1>;
};

&gpio0 {
	clocks = <&pmucru PCLK_GPIO0>, <&pmucru DBCLK_GPIO0>;
};

&gpio1 {
	clocks = <&cru PCLK_GPIO1>, <&cru DBCLK_GPIO1>;
};

&gpio2 {
	clocks = <&cru PCLK_GPIO2>, <&cru DBCLK_GPIO2>;
};

&gpio3 {
	clocks = <&cru PCLK_GPIO3>, <&cru DBCLK_GPIO3>;
};

&gpio4 {
	clocks = <&cru PCLK_GPIO4>, <&cru DBCLK_GPIO4>;
};

&gpu {
	clocks = <&scmi_clk 1>, <&cru CLK_GPU>;
	power-domains = <&power 7>;
	operating-points-v2 = <&gpu_opp_table>;
	status = "okay";
	mali-supply = <&vdd_gpu>;
};

&gpu_opp_table {
	nvmem-cells = <&gpu_leakage &core_pvtm &mbist_vmin &gpu_opp_info &specification_serial_number &remark_spec_serial_number>;
};

&gpu_pins {
	rockchip,pins = <0 RK_PC0 2 &pcfg_pull_none>,
			<0 RK_PA6 4 &pcfg_pull_none>;
};

&gpu_thermal {
	thermal-sensors = <&tsadc 1>;
};

&hdmi {
	clocks = <&cru PCLK_HDMI_HOST>, <&cru CLK_HDMI_SFR>, <&cru CLK_HDMI_CEC>, <&pmucru PLL_HPLL>, <&cru HCLK_VOP>;
	pinctrl-0 = <&hdmitx_scl &hdmitx_sda &hdmitxm0_cec>;
	power-domains = <&power 9>;
	rockchip,grf = <&grf>;
};

&hdmi_in_vp0 {
	remote-endpoint = <&vp0_out_hdmi>;
};

&hdmi_in_vp1 {
	remote-endpoint = <&vp1_out_hdmi>;
};

&hdmi_sound {
	simple-audio-card,name = "rockchip,hdmi";
	simple-audio-card,mclk-fs = <128>;

	simple-audio-card,codec {
		sound-dai = <&hdmi>;
	};

	simple-audio-card,cpu {
		sound-dai = <&i2s0_8ch>;
	};
};

&hdmitx_scl {
	rockchip,pins = <4 RK_PC7 1 &pcfg_pull_none>;
};

&hdmitx_sda {
	rockchip,pins = <4 RK_PD0 1 &pcfg_pull_none>;
};

&hdmitxm0_cec {
	rockchip,pins = <4 RK_PD1 1 &pcfg_pull_none>;
};

&hdmitxm1_cec {
	rockchip,pins = <0 RK_PC7 1 &pcfg_pull_none>;
};

&i2c0 {
	clocks = <&pmucru CLK_I2C0>, <&pmucru PCLK_I2C0>;
	pinctrl-0 = <&i2c0_xfer>;
	status = "okay";

	vdd_cpu: sti8070a@40 {
		compatible = "silergy,syr827";
		reg = <0x40>;
		vin-supply = <&vccsys>;
		regulator-compatible = "fan53555-reg";
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1390000>;
		regulator-init-microvolt = <1000000>;
		regulator-ramp-delay = <2300>;
		fcs,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default", "pmic-sleep", "pmic-power-off", "pmic-reset";
		pinctrl-0 = <&pmic_int>;
		pinctrl-1 = <&soc_slppin_slp>;
		pinctrl-2 = <&soc_slppin_gpio>;
		pinctrl-3 = <&soc_slppin_gpio>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <1>;
		clock-output-names = "rk808-clkout1", "rk808-clkout2";
		pmic-reset-func = <0>;
		not-save-power-en = <1>;
		vcc1-supply = <&vccsys>;
		vcc2-supply = <&vccsys>;
		vcc3-supply = <&vccsys>;
		vcc4-supply = <&vccsys>;
		vcc5-supply = <&vccsys>;
		vcc6-supply = <&vccsys>;
		vcc7-supply = <&vccsys>;
		vcc8-supply = <&vccsys>;
		vcc9-supply = <&dcdc_boost>;
		pwrkey {
			status = "okay";
		};
		pinctrl_rk8xx: pinctrl_rk8xx {
			gpio-controller;
			#gpio-cells = <2>;
			rk817_slppin_null: rk817_slppin_null {
				pins = "gpio_slp";
				function = "pin_fun0";
			};
			rk817_slppin_slp: rk817_slppin_slp {
				pins = "gpio_slp";
				function = "pin_fun1";
			};
			rk817_slppin_pwrdn: rk817_slppin_pwrdn {
				pins = "gpio_slp";
				function = "pin_fun2";
			};
			rk817_slppin_rst: rk817_slppin_rst {
				pins = "gpio_slp";
				function = "pin_fun3";
			};
		};
		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <950000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <2>;
				regulator-name = "vdd_logic";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};
			vdd_gpu: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <825000>;
				regulator-max-microvolt = <1350000>;
				regulator-init-microvolt = <950000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <2>;
				regulator-name = "vdd_gpu";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <2>;
				regulator-name = "vcc_ddr";
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
			vcc_3v3: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <2>;
				regulator-name = "vcc_3v3";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};
			vcca1v8_pmu: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcca1v8_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};
			vdda_0v9: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda_0v9";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vdda0v9_pmu: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda0v9_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};
			vccio_acodec: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_acodec";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_sd";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc3v3_pmu: LDO_REG6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc3v3_pmu";
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};
			vcc_1v8: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8";
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
			vcc1v8_dvp: LDO_REG8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc1v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc2v8_dvp: LDO_REG9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-name = "vcc2v8_dvp";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			dcdc_boost: BOOST {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;
				regulator-name = "boost";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
		simple_battery: simple-battery {
			compatible = "simple-battery";
			charge-full-design-microamp-hours = <2500000>;
			precharge-current-microamp = <180000>;
			precharge-upper-limit-microvolt = <3600000>;
			charge-term-current-microamp = <300000>;
			constant-charge-current-max-microamp = <10000000>;
			constant-charge-voltage-max-microvolt = <4350000>;
			factory-internal-resistance-micro-ohms = <80>;
			voltage-max-design-microvolt = <4350000>;
			voltage-min-design-microvolt = <3000000>;
		};
		battery {
			compatible = "rk817,battery";
			ocv_table = <3400 3663 3677 3707 3731 3749 3761 3772 3786 3826 3861 3908 3947 3978 4039 4083 4136 4191 4251 4338>;
			design_capacity = <4247>;
			design_qmax = <4247>;
			bat_res = <69>;
			sleep_enter_current = <150>;
			sleep_exit_current = <180>;
			sleep_filter_current = <100>;
			power_off_thresd = <3500>;
			zero_algorithm_vol = <3850>;
			max_soc_offset = <60>;
			monitor_sec = <5>;
			sample_res = <10>;
			virtual_power = <0>;
			status = "okay";
		};
		charger: charger {
			compatible = "rk817,charger";
			min_input_voltage = <4500>;
			max_input_current = <3500>;
			max_chrg_current = <3000>;
			max_chrg_voltage = <4350>;
			chrg_term_mode = <2>;
			chrg_finish_cur = <200>;
			virtual_power = <0>;
			dc_det_adc = <0>;
			extcon = <&usb2phy0>;
			status = "okay";
		};
		rk817_codec: codec {
			#sound-dai-cells = <0>;
			compatible = "rockchip,rk817-codec";
			clocks = <&cru I2S1_MCLKOUT>;
			clock-names = "mclk";
			assigned-clocks = <&cru I2S1_MCLKOUT>, <&cru I2S1_MCLK_TX_IOE>;
			assigned-clock-rates = <12288000>;
			assigned-clock-parents = <&cru I2S1_MCLKOUT_TX>, <&cru I2S1_MCLKOUT_TX>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2s1m0_mclk>;
			hp-volume = <23>;
			spk-volume = <10>;
			mic-in-differential;
			use-ext-amplifier;
			spk-ctl-gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_HIGH>;
			status = "okay";
		};
	};

	cw2015@62 {
		compatible = "cellwise,cw2015";
		reg = <0x62>;
		cellwise,battery-profile = <392659311 1768252244 1968199510 1313817653 740564507 607273293 475466629 877943149 2239857028 1008430188 188816461 2157289492 947820707 2156500939 788554917 3049342638>;
		cellwise,monitor-interval-ms = <5000>;
		monitored-battery = <&simple_battery>;
		battery_id = <0>;
		status = "okay";
	};
};

&i2c0_xfer {
	rockchip,pins = <0 RK_PB1 1 &pcfg_pull_none_smt>,
			<0 RK_PB2 1 &pcfg_pull_none_smt>;
};

&i2c1 {
	clocks = <&cru CLK_I2C1>, <&cru PCLK_I2C1>;
	pinctrl-0 = <&i2c1_xfer>;
};

&i2c1_xfer {
	rockchip,pins = <0 RK_PB3 1 &pcfg_pull_none_smt>,
			<0 RK_PB4 1 &pcfg_pull_none_smt>;
};

&i2c2 {
	clocks = <&cru CLK_I2C2>, <&cru PCLK_I2C2>;
	pinctrl-0 = <&i2c2m1_xfer>;
	status = "okay";
	clock-frequency = <200000>;
	i2c-scl-rising-time-ns = <144>;
	i2c-scl-falling-time-ns = <4>;

	aw87391_pa_l: aw87391@58 {
		compatible = "aw,aw87391-left";
		reg = <0x58>;
	};

	aw87391_pa_r: aw87391@5b {
		compatible = "aw,aw87391-right";
		reg = <0x5b>;
	};

	icm42607_acc: icm_acc@68 {
		status = "okay";
		compatible = "icm42607_acc";
		reg = <0x68>;
		irq-gpio = <&gpio0 RK_PD6 GPIO_ACTIVE_LOW>;
		irq_enable = <0>;
		poll_delay_ms = <30>;
		type = <2>;
		layout = <5>;
	};

	icm42607_gyro: icm_gyro@68 {
		status = "okay";
		compatible = "icm42607_gyro";
		reg = <0x68>;
		poll_delay_ms = <30>;
		type = <4>;
		layout = <5>;
	};

	sc7u22_acc: sc7u22_acc@18 {
		compatible = "sc7u22_acc";
		reg = <0x18>;
		type = <2>;
		irq_enable = <0>;
		poll_delay_ms = <30>;
		layout = <5>;
		status = "okay";
	};

	sc7u22_gyro: sc7u22_gyro@18 {
		compatible = "sc7u22_gyro";
		reg = <0x18>;
		type = <4>;
		irq_enable = <0>;
		poll_delay_ms = <30>;
		layout = <5>;
		status = "okay";
	};
};

&i2c2m0_xfer {
	rockchip,pins = <0 RK_PB5 1 &pcfg_pull_none_smt>,
			<0 RK_PB6 1 &pcfg_pull_none_smt>;
};

&i2c2m1_xfer {
	rockchip,pins = <4 RK_PB5 1 &pcfg_pull_none_smt>,
			<4 RK_PB4 1 &pcfg_pull_none_smt>;
};

&i2c3 {
	clocks = <&cru CLK_I2C3>, <&cru PCLK_I2C3>;
	pinctrl-0 = <&i2c3m1_xfer>;
	status = "okay";
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <144>;
	i2c-scl-falling-time-ns = <4>;

	gt9xx_1: gt9xx-1@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		touch-gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
		reset-gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		max-x = <640>;
		max-y = <480>;
		tp-size = <911>;
		ext_lcd_tp = <1>;
		flip_report_tp = <1>;
		com_lcd_tp = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch1_gt_gpio>;
		rockchip,panel-notifier = <&dsi0_panel>;
	};
};

&i2c3m0_xfer {
	rockchip,pins = <1 RK_PA1 1 &pcfg_pull_none_smt>,
			<1 RK_PA0 1 &pcfg_pull_none_smt>;
};

&i2c3m1_xfer {
	rockchip,pins = <3 RK_PB5 4 &pcfg_pull_none_smt>,
			<3 RK_PB6 4 &pcfg_pull_none_smt>;
};

&i2c4 {
	clocks = <&cru CLK_I2C4>, <&cru PCLK_I2C4>;
	pinctrl-0 = <&i2c4m0_xfer>;
};

&i2c4m0_xfer {
	rockchip,pins = <4 RK_PB3 1 &pcfg_pull_none_smt>,
			<4 RK_PB2 1 &pcfg_pull_none_smt>;
