};

&sdmmc2m0_pwren {
	rockchip,pins = <3 RK_PD5 3 &pcfg_pull_none>;
};

&sdmmc2m1_bus4 {
	rockchip,pins = <3 RK_PA1 5 &pcfg_pull_up_drv_level_2>,
			<3 RK_PA2 5 &pcfg_pull_up_drv_level_2>,
			<3 RK_PA3 5 &pcfg_pull_up_drv_level_2>,
			<3 RK_PA4 5 &pcfg_pull_up_drv_level_2>;
};

