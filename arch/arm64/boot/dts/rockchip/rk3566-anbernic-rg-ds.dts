&tsadc {
	assigned-clocks = <&cru CLK_TSADC_TSEN>, <&cru CLK_TSADC>;
	clocks = <&cru CLK_TSADC>, <&cru PCLK_TSADC>;
	resets = <&cru SRST_TSADC>, <&cru SRST_P_TSADC>, <&cru SRST_TSADCPHY>;
	rockchip,grf = <&grf>;
	nvmem-cells = <&tsadc_trim_base &tsadc_trim_base_frac>;
	pinctrl-0 = <&tsadc_gpio_func>;
	pinctrl-1 = <&tsadc_shutorg>;
	status = "okay";

	tsadc@0 {
		nvmem-cells = <&cpu_tsadc_trim_l &cpu_tsadc_trim_h>;
	};

	tsadc@1 {
		nvmem-cells = <&gpu_tsadc_trim_l &gpu_tsadc_trim_h>;
	};
};

&tsadc_gpio_func {
	rockchip,pins = <0 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
};

&tsadc_shutorg {
	rockchip,pins = <0 RK_PA1 2 &pcfg_pull_none>;
};

&tsadcm0_shut {
	rockchip,pins = <0 RK_PA1 1 &pcfg_pull_none>;
};

&tsadcm1_shut {
	rockchip,pins = <0 RK_PA2 2 &pcfg_pull_none>;
};

