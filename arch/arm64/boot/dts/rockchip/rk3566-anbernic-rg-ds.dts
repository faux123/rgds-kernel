&pinctrl {
	rockchip,grf = <&grf>;
	rockchip,pmu = <&pmugrf>;

	lcd {
		mipi_dsi0_pwr_en: mipi-dsi0-pwr-en {
			rockchip,pins = <4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		mipi_dsi1_pwr_en: mipi-dsi1-pwr-en {
			rockchip,pins = <4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		lcd_rst_gpio: lcd-rst-gpio {
			rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		lcd_enable_gpio: lcd-enable-gpio {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		lcd1_rst_gpio: lcd1-rst-gpio {
			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		lcd1_enable_gpio: lcd1-enable-gpio {
			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	tp {
		touch0_gt_gpio: touch0-gt-gpio {
			rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
					<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		touch1_gt_gpio: touch1-gt-gpio {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>,
					<0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	headphone {
		hp_det: hp-det {
			rockchip,pins = <4 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sensor {
		sensor_gpio: sensor-gpio {
			rockchip,pins = <0 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	vcc_sd {
		vcc_sd_h: vcc-sd-h {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	power-wlan-bt {
		vcc_wifi_h: vcc-wifi-h {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wireless-bluetooth {
		uart1_gpios: uart1-gpios {
			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	gpio-leds {
		leds_gpio: leds-gpio {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	btns {
		btn_pins: btn-pins {
			rockchip,pins = <2 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PD6 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PD7 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	keys {
		pwr_key: pwr-key {
			rockchip,pins = <3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	halls {
		gpio_hall: gpio-hall {
			rockchip,pins = <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	pmic {
		pmic_int: pmic_int {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		soc_slppin_gpio: soc_slppin_gpio {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_output_low>;
		};

		soc_slppin_slp: soc_slppin_slp {
			rockchip,pins = <0 RK_PA2 1 &pcfg_pull_none>;
		};

		soc_slppin_rst: soc_slppin_rst {
			rockchip,pins = <0 RK_PA2 2 &pcfg_pull_none>;
		};
	};
};

&pmic_pins {
	rockchip,pins = <0 RK_PA2 1 &pcfg_pull_none>;
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio1-supply = <&vccio_acodec>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcc_3v3>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_1v8>;
	vccio7-supply = <&vcc_3v3>;
};

&pmu_pins {
	rockchip,pins = <0 RK_PA5 4 &pcfg_pull_none>,
			<0 RK_PA6 3 &pcfg_pull_none>,
			<0 RK_PC4 4 &pcfg_pull_none>,
			<0 RK_PC5 4 &pcfg_pull_none>,
			<0 RK_PC6 4 &pcfg_pull_none>,
			<0 RK_PC7 4 &pcfg_pull_none>;
};

&pmucru {
	rockchip,grf = <&grf>;
	rockchip,pmugrf = <&pmugrf>;
	assigned-clocks = <&pmucru SCLK_32K_IOE>;
	assigned-clock-parents = <&pmucru CLK_RTC_32K>;
};

&power {
	power-domain@6 {
		clocks = <&cru ACLK_NPU_PRE>, <&cru HCLK_NPU_PRE>, <&cru PCLK_NPU_PRE>;
		pm_qos = <&qos_npu>;
	};

	power-domain@7 {
		clocks = <&cru ACLK_GPU_PRE>, <&cru PCLK_GPU_PRE>;
		pm_qos = <&qos_gpu>;
	};

	power-domain@8 {
		clocks = <&cru HCLK_VI>, <&cru PCLK_VI>;
		pm_qos = <&qos_isp &qos_vicap0 &qos_vicap1>;
	};

	power-domain@9 {
		clocks = <&cru HCLK_VO>, <&cru PCLK_VO>, <&cru ACLK_VOP_PRE>;
		pm_qos = <&qos_hdcp &qos_vop_m0 &qos_vop_m1>;
	};

	power-domain@10 {
		clocks = <&cru HCLK_RGA_PRE>, <&cru PCLK_RGA_PRE>;
		pm_qos = <&qos_ebc &qos_iep &qos_jpeg_dec &qos_jpeg_enc &qos_rga_rd &qos_rga_wr>;
	};

	power-domain@11 {
		clocks = <&cru HCLK_VPU_PRE>;
		pm_qos = <&qos_vpu>;
	};

	power-domain@13 {
		clocks = <&cru HCLK_RKVDEC_PRE>;
		pm_qos = <&qos_rkvdec>;
	};

	power-domain@14 {
		clocks = <&cru HCLK_RKVENC_PRE>;
		pm_qos = <&qos_rkvenc_rd_m0 &qos_rkvenc_rd_m1 &qos_rkvenc_wr_m0>;
	};

	power-domain@15 {
		clocks = <&cru PCLK_PIPE>;
		pm_qos = <&qos_pcie2x1 &qos_pcie3x1 &qos_pcie3x2 &qos_sata0 &qos_sata1 &qos_sata2 &qos_usb3_0 &qos_usb3_1>;
	};
};

&pwm0 {
	clocks = <&pmucru CLK_PWM0>, <&pmucru PCLK_PWM0>;
	pinctrl-0 = <&pwm0m0_pins>;
};

&pwm0m0_pins {
	rockchip,pins = <0 RK_PB7 1 &pcfg_pull_none>;
};

&pwm0m1_pins {
	rockchip,pins = <0 RK_PC7 2 &pcfg_pull_none>;
};

&pwm1 {
	clocks = <&pmucru CLK_PWM0>, <&pmucru PCLK_PWM0>;
	pinctrl-0 = <&pwm1m0_pins>;
};

&pwm10 {
	clocks = <&cru CLK_PWM2>, <&cru PCLK_PWM2>;
	pinctrl-0 = <&pwm10m0_pins>;
};

&pwm10m0_pins {
	rockchip,pins = <3 RK_PB5 5 &pcfg_pull_none>;
};

&pwm10m1_pins {
	rockchip,pins = <2 RK_PA1 2 &pcfg_pull_none>;
};

&pwm11 {
	clocks = <&cru CLK_PWM2>, <&cru PCLK_PWM2>;
	pinctrl-0 = <&pwm11m0_pins>;
};

&pwm11m0_pins {
	rockchip,pins = <3 RK_PB6 5 &pcfg_pull_none>;
};

&pwm11m1_pins {
	rockchip,pins = <4 RK_PC0 3 &pcfg_pull_none>;
};

&pwm12 {
	clocks = <&cru CLK_PWM3>, <&cru PCLK_PWM3>;
	pinctrl-0 = <&pwm12m1_pins>;
	status = "okay";
};

&pwm12m0_pins {
	rockchip,pins = <3 RK_PB7 2 &pcfg_pull_none>;
};

&pwm12m1_pins {
	rockchip,pins = <4 RK_PC5 1 &pcfg_pull_none>;
};

&pwm13 {
	clocks = <&cru CLK_PWM3>, <&cru PCLK_PWM3>;
	pinctrl-0 = <&pwm13m1_pins>;
	status = "okay";
};

&pwm13m0_pins {
	rockchip,pins = <3 RK_PC0 2 &pcfg_pull_none>;
};

&pwm13m1_pins {
	rockchip,pins = <4 RK_PC6 1 &pcfg_pull_none>;
};

&pwm14 {
	clocks = <&cru CLK_PWM3>, <&cru PCLK_PWM3>;
	pinctrl-0 = <&pwm14m0_pins>;
};

&pwm14m0_pins {
	rockchip,pins = <3 RK_PC4 1 &pcfg_pull_none>;
};

&pwm14m1_pins {
	rockchip,pins = <4 RK_PC2 1 &pcfg_pull_none>;
};

&pwm15 {
	clocks = <&cru CLK_PWM3>, <&cru PCLK_PWM3>;
	pinctrl-0 = <&pwm15m0_pins>;
};

&pwm15m0_pins {
	rockchip,pins = <3 RK_PC5 1 &pcfg_pull_none>;
};

&pwm15m1_pins {
	rockchip,pins = <4 RK_PC3 1 &pcfg_pull_none>;
};

&pwm1m0_pins {
	rockchip,pins = <0 RK_PC0 1 &pcfg_pull_none>;
};

&pwm1m1_pins {
	rockchip,pins = <0 RK_PB5 4 &pcfg_pull_none>;
};

&pwm2 {
	clocks = <&pmucru CLK_PWM0>, <&pmucru PCLK_PWM0>;
	pinctrl-0 = <&pwm2m0_pins>;
};

&pwm2m0_pins {
	rockchip,pins = <0 RK_PC1 1 &pcfg_pull_none>;
};

&pwm2m1_pins {
	rockchip,pins = <0 RK_PB6 4 &pcfg_pull_none>;
};

&pwm3 {
	clocks = <&pmucru CLK_PWM0>, <&pmucru PCLK_PWM0>;
	pinctrl-0 = <&pwm3_pins>;
};

&pwm3_pins {
	rockchip,pins = <0 RK_PC2 1 &pcfg_pull_none>;
};

&pwm4 {
	clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>;
	pinctrl-0 = <&pwm4_pins>;
};

&pwm4_pins {
	rockchip,pins = <0 RK_PC3 1 &pcfg_pull_none>;
};

&pwm5 {
	clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>;
	pinctrl-0 = <&pwm5_pins>;
};

&pwm5_pins {
	rockchip,pins = <0 RK_PC4 1 &pcfg_pull_none>;
};

&pwm6 {
	clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>;
	pinctrl-0 = <&pwm6_pins>;
};

&pwm6_pins {
	rockchip,pins = <0 RK_PC5 1 &pcfg_pull_none>;
};

&pwm7 {
	clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>;
	pinctrl-0 = <&pwm7_pins>;
};

&pwm7_pins {
	rockchip,pins = <0 RK_PC6 1 &pcfg_pull_none>;
};

&pwm8 {
	clocks = <&cru CLK_PWM2>, <&cru PCLK_PWM2>;
	pinctrl-0 = <&pwm8m0_pins>;
};

&pwm8m0_pins {
	rockchip,pins = <3 RK_PB1 5 &pcfg_pull_none>;
};

&pwm8m1_pins {
	rockchip,pins = <1 RK_PD5 4 &pcfg_pull_none>;
};

&pwm9 {
	clocks = <&cru CLK_PWM2>, <&cru PCLK_PWM2>;
	pinctrl-0 = <&pwm9m0_pins>;
};

&pwm9m0_pins {
	rockchip,pins = <3 RK_PB2 5 &pcfg_pull_none>;
};

&pwm9m1_pins {
	rockchip,pins = <1 RK_PD6 4 &pcfg_pull_none>;
};

&refclk_pins {
	rockchip,pins = <0 RK_PA0 1 &pcfg_pull_none>;
};

&rgb {
	pinctrl-0 = <&lcdc_ctl>;
};

&rgb_in_vp2 {
	remote-endpoint = <&vp2_out_rgb>;
};

&rk_rga {
	clocks = <&cru ACLK_RGA>, <&cru HCLK_RGA>, <&cru CLK_RGA_CORE>;
	power-domains = <&power 10>;
	status = "okay";
};

&rkcif {
	clocks = <&cru ACLK_VICAP>, <&cru HCLK_VICAP>, <&cru DCLK_VICAP>, <&cru ICLK_VICAP_G>;
	resets = <&cru SRST_A_VICAP>, <&cru SRST_H_VICAP>, <&cru SRST_D_VICAP>, <&cru SRST_P_VICAP>, <&cru SRST_I_VICAP>;
	assigned-clocks = <&cru DCLK_VICAP>;
	power-domains = <&power 8>;
	rockchip,grf = <&grf>;
	iommus = <&rkcif_mmu>;
};

&rkcif_dvp {
	rockchip,hw = <&rkcif>;
};

&rkcif_dvp_sditf {
	rockchip,cif = <&rkcif_dvp>;
};

&rkcif_mipi_lvds {
	rockchip,hw = <&rkcif>;
};

&rkcif_mipi_lvds_sditf {
	rockchip,cif = <&rkcif_mipi_lvds>;
};

&rkcif_mmu {
	clocks = <&cru ACLK_VICAP>, <&cru HCLK_VICAP>;
	power-domains = <&power 8>;
};

&rkisp {
	clocks = <&cru ACLK_ISP>, <&cru HCLK_ISP>, <&cru CLK_ISP>;
	resets = <&cru SRST_ISP>, <&cru SRST_H_ISP>;
	rockchip,grf = <&grf>;
	power-domains = <&power 8>;
	iommus = <&rkisp_mmu>;
};

&rkisp_mmu {
	clocks = <&cru ACLK_ISP>, <&cru HCLK_ISP>;
	power-domains = <&power 8>;
};

&rkisp_vir0 {
	rockchip,hw = <&rkisp>;
};

&rkisp_vir1 {
	rockchip,hw = <&rkisp>;
};

&rknpu {
	clocks = <&scmi_clk 2>, <&cru CLK_NPU>, <&cru ACLK_NPU>, <&cru HCLK_NPU>;
	assigned-clocks = <&cru CLK_NPU>;
	resets = <&cru SRST_A_NPU>, <&cru SRST_H_NPU>;
	power-domains = <&power 6>;
	operating-points-v2 = <&npu_opp_table>;
	iommus = <&rknpu_mmu>;
};

&rknpu_mmu {
	clocks = <&cru ACLK_NPU>, <&cru HCLK_NPU>;
	power-domains = <&power 6>;
};

&rktimer {
	clocks = <&cru PCLK_TIMER>, <&cru CLK_TIMER0>;
};

&rkvdec {
	clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>, <&cru CLK_RKVDEC_CA>, <&cru CLK_RKVDEC_CORE>, <&cru CLK_RKVDEC_HEVC_CA>;
	resets = <&cru SRST_A_RKVDEC>, <&cru SRST_H_RKVDEC>, <&cru SRST_RKVDEC_CA>, <&cru SRST_RKVDEC_CORE>, <&cru SRST_RKVDEC_HEVC_CA>;
	assigned-clocks = <&cru ACLK_RKVDEC>, <&cru CLK_RKVDEC_CA>, <&cru CLK_RKVDEC_CORE>, <&cru CLK_RKVDEC_HEVC_CA>;
	power-domains = <&power 13>;
	operating-points-v2 = <&rkvdec_opp_table>;
	vdec-supply = <&vdd_logic>;
	iommus = <&rkvdec_mmu>;
	rockchip,srv = <&mpp_srv>;
	rockchip,sram = <&rkvdec_sram>;
	status = "okay";
};

&rkvdec_mmu {
	clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>;
	power-domains = <&power 13>;
	status = "okay";
};

&rkvdec_opp_table {
	nvmem-cells = <&log_leakage &core_pvtm>;
};

&rkvenc {
	clocks = <&cru ACLK_RKVENC>, <&cru HCLK_RKVENC>, <&cru CLK_RKVENC_CORE>;
	resets = <&cru SRST_A_RKVENC>, <&cru SRST_H_RKVENC>, <&cru SRST_RKVENC_CORE>;
	assigned-clocks = <&cru ACLK_RKVENC>, <&cru CLK_RKVENC_CORE>;
	iommus = <&rkvenc_mmu>;
	rockchip,srv = <&mpp_srv>;
	power-domains = <&power 14>;
	operating-points-v2 = <&rkvenc_opp_table>;
	status = "okay";
};

&rkvenc_mmu {
	clocks = <&cru ACLK_RKVENC>, <&cru HCLK_RKVENC>;
	power-domains = <&power 14>;
	status = "okay";
};

&rkvenc_opp_table {
	nvmem-cells = <&core_pvtm>;
};

&rng {
	clocks = <&cru CLK_TRNG_NS>, <&cru HCLK_TRNG_NS>;
	resets = <&cru SRST_TRNG_NS>;
};

&route_dsi0 {
	status = "okay";
	connect = <&vp0_out_dsi0>;
};

&route_dsi1 {
	status = "okay";
	connect = <&vp1_out_dsi1>;
};

&route_edp {
	connect = <&vp0_out_edp>;
};

&route_hdmi {
	connect = <&vp0_out_hdmi>;
};

&route_lvds {
	connect = <&vp1_out_lvds>;
};

&route_rgb {
	connect = <&vp2_out_rgb>;
};

&saradc {
	clocks = <&cru CLK_SARADC>, <&cru PCLK_SARADC>;
	resets = <&cru SRST_P_SARADC>;
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sata0 {
	clocks = <&cru ACLK_SATA0>, <&cru CLK_SATA0_PMALIVE>, <&cru CLK_SATA0_RXOOB>;
	phys = <&combphy0_us 1>;
	power-domains = <&power 15>;
};

&sata0_pins {
	rockchip,pins = <4 RK_PC6 3 &pcfg_pull_none>;
};

&sata1 {
	clocks = <&cru ACLK_SATA1>, <&cru CLK_SATA1_PMALIVE>, <&cru CLK_SATA1_RXOOB>;
	phys = <&combphy1_usq 1>;
	power-domains = <&power 15>;
};

&sata1_pins {
	rockchip,pins = <4 RK_PC5 3 &pcfg_pull_none>;
};

&sata2 {
	clocks = <&cru ACLK_SATA2>, <&cru CLK_SATA2_PMALIVE>, <&cru CLK_SATA2_RXOOB>;
	phys = <&combphy2_psq 1>;
	power-domains = <&power 15>;
};

&sata2_pins {
	rockchip,pins = <4 RK_PC4 3 &pcfg_pull_none>;
};

&sata_pins {
	rockchip,pins = <0 RK_PA4 2 &pcfg_pull_none>,
			<0 RK_PA6 1 &pcfg_pull_none>,
			<0 RK_PA5 2 &pcfg_pull_none>;
};

&scmi {
	shmem = <&scmi_shmem>;
};

&scr {
	pinctrl-0 = <&scr_pins>;
	clocks = <&cru PCLK_SCR>;
};

&scr_pins {
	rockchip,pins = <1 RK_PA2 3 &pcfg_pull_none>,
			<1 RK_PA7 3 &pcfg_pull_up>,
			<1 RK_PA3 3 &pcfg_pull_up>,
			<1 RK_PA5 3 &pcfg_pull_none>;
};

&sdhci {
	assigned-clocks = <&cru BCLK_EMMC>, <&cru TCLK_EMMC>, <&cru CCLK_EMMC>;
	clocks = <&cru CCLK_EMMC>, <&cru HCLK_EMMC>, <&cru ACLK_EMMC>, <&cru BCLK_EMMC>, <&cru TCLK_EMMC>;
	resets = <&cru SRST_C_EMMC>, <&cru SRST_H_EMMC>, <&cru SRST_A_EMMC>, <&cru SRST_B_EMMC>, <&cru SRST_T_EMMC>;
	status = "okay";
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
};

&sdmmc0 {
	clocks = <&cru HCLK_SDMMC0>, <&cru CLK_SDMMC0>, <&cru SCLK_SDMMC0_DRV>, <&cru SCLK_SDMMC0_SAMPLE>;
	resets = <&cru SRST_SDMMC0>;
	status = "okay";
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
};

&sdmmc0_bus4 {
	rockchip,pins = <1 RK_PD5 1 &pcfg_pull_up_drv_level_2>,
			<1 RK_PD6 1 &pcfg_pull_up_drv_level_2>,
			<1 RK_PD7 1 &pcfg_pull_up_drv_level_2>,
			<2 RK_PA0 1 &pcfg_pull_up_drv_level_2>;
};

&sdmmc0_clk {
	rockchip,pins = <2 RK_PA2 1 &pcfg_pull_up_drv_level_2>;
};

&sdmmc0_cmd {
	rockchip,pins = <2 RK_PA1 1 &pcfg_pull_up_drv_level_2>;
};

&sdmmc0_det {
	rockchip,pins = <0 RK_PA4 1 &pcfg_pull_up>;
};

&sdmmc0_pwren {
	rockchip,pins = <0 RK_PA5 1 &pcfg_pull_none>;
};

&sdmmc1 {
	clocks = <&cru HCLK_SDMMC1>, <&cru CLK_SDMMC1>, <&cru SCLK_SDMMC1_DRV>, <&cru SCLK_SDMMC1_SAMPLE>;
	resets = <&cru SRST_SDMMC1>;
};

&sdmmc1_bus4 {
	rockchip,pins = <2 RK_PA3 1 &pcfg_pull_up_drv_level_2>,
			<2 RK_PA4 1 &pcfg_pull_up_drv_level_2>,
			<2 RK_PA5 1 &pcfg_pull_up_drv_level_2>,
			<2 RK_PA6 1 &pcfg_pull_up_drv_level_2>;
};

