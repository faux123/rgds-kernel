&i2s0_8ch {
	clocks = <&cru 63 &cru 67 &cru 57>;
	dmas = <&dmac1 0>;
	resets = <&cru 80 &cru 81>;
	rockchip,cru = <&cru>;
	rockchip,grf = <&grf>;
