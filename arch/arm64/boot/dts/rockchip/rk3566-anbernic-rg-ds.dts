};

&i2c5 {
	clocks = <&cru CLK_I2C5>, <&cru PCLK_I2C5>;
	pinctrl-0 = <&i2c5m0_xfer>;
	status = "okay";
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <144>;
	i2c-scl-falling-time-ns = <4>;

	gt9xx_0: gt9xx-0@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		touch-gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
		reset-gpio = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
		max-x = <640>;
		max-y = <480>;
		tp-size = <911>;
		ext_lcd_tp = <0>;
		flip_report_tp = <0>;
		com_lcd_tp = <0>;
		pinctrl-names = "default";
