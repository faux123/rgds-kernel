			rockchip,pins = <0x4 0x3 0x0 &pcfg_pull_none>;
		};
		lcd_rst_gpio: lcd-rst-gpio {
			rockchip,pins = <0x0 0xb 0x0 &pcfg_pull_none>;
		};
		lcd_enable_gpio: lcd-enable-gpio {
			rockchip,pins = <0x0 0x8 0x0 &pcfg_pull_none 0x0 0x17 0x0 &pcfg_pull_none>;
		};
		lcd1_rst_gpio: lcd1-rst-gpio {
			rockchip,pins = <0x0 0xc 0x0 &pcfg_pull_none>;
		};
		lcd1_enable_gpio: lcd1-enable-gpio {
			rockchip,pins = <0x0 0x11 0x0 &pcfg_pull_none 0x0 0x12 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	tp {
		touch0_gt_gpio: touch0-gt-gpio {
			rockchip,pins = <0x0 0xd 0x0 &pcfg_pull_up 0x0 0xe 0x0 &pcfg_pull_up>;
		};
		touch1_gt_gpio: touch1-gt-gpio {
			rockchip,pins = <0x0 0xf 0x0 &pcfg_pull_up 0x0 0x10 0x0 &pcfg_pull_up>;
		};
	};
};

&pinctrl {
	headphone {
		hp_det: hp-det {
			rockchip,pins = <0x4 0x12 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	sensor {
		sensor_gpio: sensor-gpio {
			rockchip,pins = <0x0 0x1e 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0x4 0x2 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	vcc_sd {
		vcc_sd_h: vcc-sd-h {
			rockchip,pins = <0x0 0x5 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	power-wlan-bt {
		vcc_wifi_h: vcc-wifi-h {
			rockchip,pins = <0x0 0x0 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0x4 0x1 0x0 &pcfg_pull_down>;
		};
	};
};

&pinctrl {
	wireless-bluetooth {
		uart1_gpios: uart1-gpios {
			rockchip,pins = <0x4 0xe 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	gpio-leds {
		leds_gpio: leds-gpio {
			rockchip,pins = <0x0 0x15 0x0 &pcfg_pull_none 0x0 0x16 0x0 &pcfg_pull_none 0x0 0x14 0x0 &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	btns {
		btn_pins: btn-pins {
			rockchip,pins = <0x2 0x18 0x0 &pcfg_pull_up 0x2 0x19 0x0 &pcfg_pull_up 0x2 0x1a 0x0 &pcfg_pull_up 0x2 0x1b 0x0 &pcfg_pull_up 0x2 0x1c 0x0 &pcfg_pull_up 0x2 0x1d 0x0 &pcfg_pull_up 0x2 0x1e 0x0 &pcfg_pull_up 0x2 0x1f 0x0 &pcfg_pull_up 0x3 0x0 0x0 &pcfg_pull_up 0x3 0x3 0x0 &pcfg_pull_up 0x3 0x4 0x0 &pcfg_pull_up 0x3 0x5 0x0 &pcfg_pull_up 0x3 0x6 0x0 &pcfg_pull_up 0x3 0x7 0x0 &pcfg_pull_up 0x3 0x8 0x0 &pcfg_pull_up 0x3 0x9 0x0 &pcfg_pull_up 0x3 0xa 0x0 &pcfg_pull_up 0x3 0xf 0x0 &pcfg_pull_up 0x3 0x10 0x0 &pcfg_pull_up 0x3 0x11 0x0 &pcfg_pull_up 0x3 0x12 0x0 &pcfg_pull_up 0x3 0x13 0x0 &pcfg_pull_up>;
		};
	};
};

&pinctrl {
	keys {
		pwr_key: pwr-key {
			rockchip,pins = <0x3 0x1 0x0 &pcfg_pull_up 0x3 0x2 0x0 &pcfg_pull_up>;
		};
	};
};

&pinctrl {
	halls {
		gpio_hall: gpio-hall {
			rockchip,pins = <0x0 0x13 0x0 &pcfg_pull_up>;
		};
	};
};

&sata0 {
	clocks = <&cru 0x96 &cru 0x97 &cru 0x98>;
	phys = <&combphy0_us 0x1>;
	power-domains = <&power 0xf>;
};

&pcie3x1 {
	clocks = <&cru 0x88 &cru 0x89 &cru 0x8a &cru 0x8b &cru 0x8c>;
	interrupt-map = <0x0 0x0 0x0 0x1 &pcie3x1_intc 0x0 0x0 0x0 0x0 0x2 &pcie3x1_intc 0x1 0x0 0x0 0x0 0x3 &pcie3x1_intc 0x2 0x0 0x0 0x0 0x4 &pcie3x1_intc 0x3>;
	msi-map = <0x1000 &its 0x1000 0x1000>;
	phys = <&pcie30phy>;
	power-domains = <&power 0xf>;
	resets = <&cru 0xb1>;
};

&pcie3x2 {
	clocks = <&cru 0x8f &cru 0x90 &cru 0x91 &cru 0x92 &cru 0x93>;
	interrupt-map = <0x0 0x0 0x0 0x1 &pcie3x2_intc 0x0 0x0 0x0 0x0 0x2 &pcie3x2_intc 0x1 0x0 0x0 0x0 0x3 &pcie3x2_intc 0x2 0x0 0x0 0x0 0x4 &pcie3x2_intc 0x3>;
	msi-map = <0x2000 &its 0x2000 0x1000>;
	phys = <&pcie30phy>;
	power-domains = <&power 0xf>;
	resets = <&cru 0xc1>;
};

&gmac_uio0 {
	rockchip,ethernet = <&gmac0>;
};

&gmac0 {
	clocks = <&cru 0x182 &cru 0x185 &cru 0x185 &cru 0xb8 &cru 0xb4 &cru 0xb5 &cru 0x185 &cru 0xb9 &cru 0xac &cru 0xab>;
	resets = <&cru 0xd7>;
	rockchip,grf = <&grf>;
	snps,axi-config = <&gmac0_stmmac_axi_setup>;
	snps,mtl-rx-config = <&gmac0_mtl_rx_setup>;
	snps,mtl-tx-config = <&gmac0_mtl_tx_setup>;
};

&combphy0_us {
	clocks = <&pmucru 0x1f &cru 0x17c &cru 0x7f>;
	assigned-clocks = <&pmucru 0x1f>;
	resets = <&cru 0x1c4 &cru 0x1c5>;
	rockchip,pipe-grf = <&pipegrf>;
	rockchip,pipe-phy-grf = <&pipe_phy_grf0>;
};

&pcie30phy {
	clocks = <&pmucru 0x26 &pmucru 0x27 &cru 0x177>;
	resets = <&cru 0x1be>;
	rockchip,phy-grf = <&pcie30_phy_grf>;
};

&{/fiq-debugger} {
	pinctrl-0 = <&uart2m0_xfer>;
};

&vendor_storage {
	memory-region = <&vendor_storage_rm>;
};

/ {
