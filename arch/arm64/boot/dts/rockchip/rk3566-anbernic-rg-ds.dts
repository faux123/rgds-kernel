&i2c2m1_xfer {
	rockchip,pins = <4 RK_PB5 1 &pcfg_pull_none_smt>,
			<4 RK_PB4 1 &pcfg_pull_none_smt>;
};

&i2c3 {
	clocks = <&cru 332 &cru 331>;
	pinctrl-0 = <&i2c3m1_xfer>;
	status = "okay";
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <144>;
