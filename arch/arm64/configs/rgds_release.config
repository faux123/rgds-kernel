# RG DS release configuration (1.0 and later). Apply after the stock config and the ThinLTO fragment:
#   cp arch/arm64/configs/rgds_v1.21_stock.config .config
#   make ARCH=arm64 LLVM=1 rgds_thinlto.config rgds_release.config
# Transparent huge pages are on by default from 1.0, in madvise mode (Paul, 2026-11-24).
# On the device since 2026-11-23: Mario Kart DS races at the same FPS as the stock kernel.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
# Wi-Fi driver built in, so the kernel needs no out-of-tree 8821cs.ko.
CONFIG_RTL8821CS=y
